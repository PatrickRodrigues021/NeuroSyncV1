@model IEnumerable<NeuroSync.Models.Terapia>

@{
    ViewData["Title"] = "Terapias";
}

<style>
    /* Estilos do Painel de Terapias */
    .terapias-container {
        padding-top: 0.5rem;
        padding-bottom: 3rem;
    }

    .page-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #0F172A;
        letter-spacing: -0.5px;
    }

    .btn-nova-terapia {
        background-color: #2563EB;
        color: #FFFFFF;
        border: none;
        border-radius: 12px;
        padding: 9px 20px;
        font-weight: 600;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
        box-shadow: 0 2px 6px rgba(37, 99, 235, 0.2);
    }

    .btn-nova-terapia:hover {
        background-color: #1D4ED8;
        color: #FFFFFF;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    }

    /* Cards de Terapia */
    .terapia-card {
        background: #FFFFFF;
        border-radius: 16px;
        padding: 28px 24px;
        border: 1px solid rgba(226, 232, 240, 0.8);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        height: 100%;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        position: relative;
    }

    .terapia-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.06);
        border-color: #CBD5E1;
        color: inherit;
    }

    /* Círculo do Ícone */
    .terapia-icon-box {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        margin-bottom: 22px;
        transition: transform 0.2s ease;
    }

    .terapia-card:hover .terapia-icon-box {
        transform: scale(1.06);
    }

    .terapia-nome {
        font-size: 1.25rem;
        font-weight: 700;
        color: #0F172A;
        margin-bottom: 8px;
        letter-spacing: -0.3px;
    }

    .terapia-descricao {
        font-size: 0.88rem;
        color: #64748B;
        line-height: 1.5;
        margin-bottom: 24px;
        flex-grow: 1;
    }

    .terapia-pacientes-label {
        font-size: 0.78rem;
        color: #94A3B8;
        font-weight: 500;
        margin-bottom: 4px;
    }

    .terapia-pacientes-valor {
        font-size: 1.9rem;
        font-weight: 700;
        color: #0F172A;
        line-height: 1;
    }

    /* Card "+ Nova terapia" (Borda tracejada) */
    .card-add-terapia {
        background: transparent;
        border-radius: 16px;
        border: 2px dashed #CBD5E1;
        padding: 28px 24px;
        height: 100%;
        min-height: 280px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .card-add-terapia:hover {
        border-color: #2563EB;
        background: #F8FAFC;
        transform: translateY(-2px);
    }

    .add-icon-circle {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background-color: #EFF6FF;
        color: #2563EB;
        font-size: 1.6rem;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 14px;
        transition: all 0.2s ease;
    }

    .card-add-terapia:hover .add-icon-circle {
        background-color: #2563EB;
        color: #FFFFFF;
        transform: scale(1.08);
    }

    .add-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: #0F172A;
        margin-bottom: 6px;
    }

    .add-subtitle {
        font-size: 0.85rem;
        color: #94A3B8;
        font-weight: 500;
        max-width: 180px;
    }
</style>

<div class="terapias-container">

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Erro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- CABEÇALHO DA PÁGINA -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="page-title mb-0">Terapias</h2>
            <p class="text-muted small fw-semibold mb-0">Especialidades e modalidades de atendimento da clínica</p>
        </div>

        <button type="button" class="btn-nova-terapia" data-bs-toggle="modal" data-bs-target="#modalNovaTerapia">
            <i class="bi bi-plus-lg"></i>
            <span>Nova terapia</span>
        </button>
    </div>

    <!-- GRID DE CARDS (3 COLUNAS) -->
    <div class="row g-4">
        
        @if (Model != null)
        {
            foreach (var terapia in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <a asp-action="Detalhes" asp-route-id="@terapia.Id" class="terapia-card">
                        
                        <!-- Ícone Redondo com Cor Temática -->
                        <div class="terapia-icon-box" style="background-color: @terapia.CorFundoHex; color: @terapia.CorHex; border: 1px solid @(terapia.CorHex)33;">
                            <i class="bi @terapia.Icone"></i>
                        </div>

                        <!-- Título e Descrição -->
                        <h4 class="terapia-nome">@terapia.Nome</h4>
                        <p class="terapia-descricao">@terapia.Descricao</p>

                        <!-- Indicador de Pacientes Ativos -->
                        <div class="mt-auto">
                            <div class="terapia-pacientes-label">Pacientes ativos</div>
                            <div class="terapia-pacientes-valor">@terapia.PacientesAtivosCount</div>
                        </div>
                    </a>
                </div>
            }
        }

        <!-- 6º CARD: "+ NOVA TERAPIA" (BORDA TRACEJADA) -->
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card-add-terapia" data-bs-toggle="modal" data-bs-target="#modalNovaTerapia">
                <div class="add-icon-circle">
                    <i class="bi bi-plus"></i>
                </div>
                <h5 class="add-title">Nova terapia</h5>
                <p class="add-subtitle mb-0">Cadastre uma nova área de atendimento</p>
            </div>
        </div>

    </div>

</div>

<!-- MODAL: CADASTRAR NOVA TERAPIA -->
<div class="modal fade" id="modalNovaTerapia" tabindex="-1" aria-labelledby="modalNovaTerapiaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="modalNovaTerapiaLabel">
                    <i class="bi bi-puzzle text-primary me-2"></i> Cadastrar Nova Terapia
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body pt-3">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Nome da Especialidade</label>
                        <input type="text" name="Nome" class="form-control rounded-3" placeholder="Ex: Musicoterapia, Psicomotricidade..." required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Descrição Clínica</label>
                        <textarea name="Descricao" rows="3" class="form-control rounded-3" placeholder="Breve resumo da finalidade e atuação terapêutica..."></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Ícone Representativo</label>
                            <select name="Icone" class="form-select rounded-3">
                                <option value="bi-puzzle-fill">Peça de Quebra-cabeça</option>
                                <option value="bi-chat-quote-fill">Comunicação / Fono</option>
                                <option value="bi-balloon-heart-fill">Psicologia / Emoção</option>
                                <option value="bi-hand-index-thumb-fill">Mão / Terapia Ocupacional</option>
                                <option value="bi-person-walking">Mobilidade / Fisioterapia</option>
                                <option value="bi-music-note-beamed">Música / Musicoterapia</option>
                                <option value="bi-book-half">Pedagogia / Leitura</option>
                                <option value="bi-heart-pulse-fill">Saúde Geral</option>
                            </select>
                        </div>

                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Cor Tema</label>
                            <select name="CorHex" class="form-select rounded-3" id="selectCorTema">
                                <option value="#2563EB" data-bg="#EFF6FF">Azul Royal</option>
                                <option value="#8B5CF6" data-bg="#F5F3FF">Roxo / Lilás</option>
                                <option value="#0D9488" data-bg="#F0FDFA">Verde Turquesa</option>
                                <option value="#E11D48" data-bg="#FFF1F2">Coral / Rosa</option>
                                <option value="#D97706" data-bg="#FFFBEB">Âmbar / Laranja</option>
                                <option value="#059669" data-bg="#ECFDF5">Verde Esmeralda</option>
                            </select>
                            <input type="hidden" name="CorFundoHex" id="inputCorFundo" value="#EFF6FF" />
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Salvar Terapia</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const selectCor = document.getElementById('selectCorTema');
            const inputBg = document.getElementById('inputCorFundo');
            if (selectCor && inputBg) {
                selectCor.addEventListener('change', function () {
                    const selectedOpt = this.options[this.selectedIndex];
                    inputBg.value = selectedOpt.getAttribute('data-bg') || '#EFF6FF';
                });
            }
        });
    </script>
}

