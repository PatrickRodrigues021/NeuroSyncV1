@model NeuroSync.Models.Evolucao
@{
    var codigoEvolucao = $"#EV{Model.IdEvolucao:D4}";
    var protocoloDigital = $"EV-{Model.IdEvolucao}-{(Model.DataRegistro.Ticks.ToString().Length >= 8 ? Model.DataRegistro.Ticks.ToString().Substring(0, 8) : Model.DataRegistro.Ticks.ToString())}";
    var prontuarioId = $"#{Model.PacienteId:D4}";

    ViewData["Title"] = $"Evolução {codigoEvolucao} - {Model.Paciente?.Nome}";

    var paciente = Model.Paciente;
    var idade = 0;
    if (paciente != null)
    {
        idade = DateTime.Today.Year - paciente.DataNascimento.Year;
        if (paciente.DataNascimento.Date > DateTime.Today.AddYears(-idade)) idade--;
    }

    var tipoEv = string.IsNullOrWhiteSpace(Model.TipoEvolucao) ? "Sessão Terapêutica" : Model.TipoEvolucao;
    var profEv = string.IsNullOrWhiteSpace(Model.ProfissionalNome) ? "Profissional Clínico" : Model.ProfissionalNome;

    string GetBadgeClass(string tipo) => tipo switch
    {
        "Sessão Terapêutica" => "badge-tipo-sessao",
        "Avaliação Diagnóstica" => "badge-tipo-avaliacao",
        "Intervenção Neuropsicopedagógica" => "badge-tipo-intervencao",
        "Estimulação Cognitiva / Motora" => "badge-tipo-estimulacao",
        "Orientação Familiar / Parental" => "badge-tipo-orientacao",
        "Reunião Escolar" => "badge-tipo-escolar",
        "Observação Comportamental" => "badge-tipo-observacao",
        "Encerramento / Devolutiva" => "badge-tipo-encerramento",
        _ => "badge-tipo-sessao"
    };

    string GetBadgeIcon(string tipo) => tipo switch
    {
        "Sessão Terapêutica" => "bi-activity",
        "Avaliação Diagnóstica" => "bi-clipboard-pulse",
        "Intervenção Neuropsicopedagógica" => "bi-mortarboard",
        "Estimulação Cognitiva / Motora" => "bi-lightning-charge",
        "Orientação Familiar / Parental" => "bi-people",
        "Reunião Escolar" => "bi-building",
        "Observação Comportamental" => "bi-eye",
        "Encerramento / Devolutiva" => "bi-check-all",
        _ => "bi-journal-medical"
    };
}

<style>
    /* Badges com alto contraste e máxima legibilidade para qualquer versão do Bootstrap */
    .badge-tipo-sessao {
        background-color: #eff6ff !important;
        color: #1e40af !important;
        border: 1px solid #bfdbfe !important;
    }
    .badge-tipo-avaliacao {
        background-color: #f0fdf4 !important;
        color: #166534 !important;
        border: 1px solid #bbf7d0 !important;
    }
    .badge-tipo-intervencao {
        background-color: #faf5ff !important;
        color: #6b21a8 !important;
        border: 1px solid #e9d5ff !important;
    }
    .badge-tipo-estimulacao {
        background-color: #ecfeff !important;
        color: #0e7490 !important;
        border: 1px solid #a5f3fc !important;
    }
    .badge-tipo-orientacao {
        background-color: #fffbeb !important;
        color: #92400e !important;
        border: 1px solid #fde68a !important;
    }
    .badge-tipo-escolar {
        background-color: #fef2f2 !important;
        color: #991b1b !important;
        border: 1px solid #fecaca !important;
    }
    .badge-tipo-observacao {
        background-color: #f8fafc !important;
        color: #334155 !important;
        border: 1px solid #cbd5e1 !important;
    }
    .badge-tipo-encerramento {
        background-color: #f1f5f9 !important;
        color: #0f172a !important;
        border: 1px solid #94a3b8 !important;
    }
</style>

<div class="container-fluid py-3 px-3 px-md-4">

    <!-- BREADCRUMB -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/Pacientes" class="text-decoration-none text-muted">Pacientes</a></li>
            @if (paciente != null)
            {
                <li class="breadcrumb-item">
                    <a href="/Pacientes/Details/@paciente.IdPaciente?aba=evolucao" class="text-decoration-none text-muted">
                        @paciente.Nome
                    </a>
                </li>
            }
            <li class="breadcrumb-item active text-primary fw-bold" aria-current="page">Evolução @codigoEvolucao</li>
        </ol>
    </nav>

    <!-- HEADER / HERO -->
    <div class="bg-white rounded-4 p-4 mb-4 border shadow-sm d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div style="width: 56px; height: 56px; border-radius: 16px; background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); color: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; border: 1px solid #bfdbfe;">
                <i class="bi bi-journal-medical"></i>
            </div>
            <div>
                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                    <h4 class="fw-bold text-dark mb-0">Evolução Clínica</h4>
                    <span class="badge @GetBadgeClass(tipoEv) rounded-pill px-3 py-1 fw-bold fs-6">
                        <i class="bi @GetBadgeIcon(tipoEv) me-1"></i>@tipoEv
                    </span>
                    <span class="badge bg-light text-secondary border rounded-pill px-3 py-1 fw-bold">
                        @codigoEvolucao
                    </span>
                </div>
                <p class="text-muted small mb-0">
                    <i class="bi bi-calendar-check text-primary me-1"></i>Registrado em <strong>@Model.DataRegistro.ToString("dd/MM/yyyy 'às' HH:mm")</strong> por <strong>@profEv</strong>
                </p>
            </div>
        </div>

        <!-- AÇÕES -->
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a href="/Pacientes/Details/@Model.PacienteId?aba=evolucao" class="btn btn-outline-secondary rounded-pill px-3 fw-semibold">
                <i class="bi bi-arrow-left me-1"></i>Voltar ao Prontuário
            </a>
            <a href="/Pacientes/ImprimirEvolucao/@Model.IdEvolucao" target="_blank" class="btn btn-outline-dark rounded-pill px-3 fw-semibold shadow-sm">
                <i class="bi bi-printer me-1"></i>Imprimir Timbrado
            </a>
            <a href="/Pacientes/GerarEvolucaoPdf/@Model.IdEvolucao" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i>Baixar PDF
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- DETALHES DO PACIENTE & SESSÃO -->
        <div class="col-lg-4">
            <div class="card border-0 rounded-4 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom p-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-person-badge text-primary me-2"></i>Identificação do Paciente
                    </h6>
                </div>
                <div class="card-body p-3">
                    @if (paciente != null)
                    {
                        <div class="mb-3">
                            <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.72rem;">Nome do Paciente</small>
                            <span class="fw-bold text-dark fs-6">@paciente.Nome</span>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.72rem;">Idade</small>
                                <span class="fw-semibold text-dark">@idade anos</span>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.72rem;">Nascimento</small>
                                <span class="fw-semibold text-dark">@paciente.DataNascimento.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.72rem;">Responsável</small>
                            <span class="fw-semibold text-dark">
                                @(!string.IsNullOrWhiteSpace(paciente.Responsavel) ? paciente.Responsavel :
                                  !string.IsNullOrWhiteSpace(paciente.NomeMae) ? paciente.NomeMae :
                                  !string.IsNullOrWhiteSpace(paciente.NomePai) ? paciente.NomePai : "-")
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(paciente.Telefone))
                        {
                            <div class="mb-3">
                                <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.72rem;">Contato</small>
                                <span class="fw-semibold text-dark"><i class="bi bi-telephone text-primary me-1"></i>@paciente.Telefone</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">Dados do paciente não disponíveis.</p>
                    }
                </div>
            </div>

            <!-- METADADOS DA SESSÃO -->
            <div class="card border-0 rounded-4 shadow-sm">
                <div class="card-header bg-white border-bottom p-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-sliders text-primary me-2"></i>Metadados da Sessão
                    </h6>
                </div>
                <div class="card-body p-3">
                    <div class="mb-3">
                        <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.72rem;">Tipo de Atendimento</small>
                        <span class="badge @GetBadgeClass(tipoEv) rounded-pill px-3 py-1 fw-bold mt-1">
                            <i class="bi @GetBadgeIcon(tipoEv) me-1"></i>@tipoEv
                        </span>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.72rem;">Data e Horário</small>
                        <span class="fw-bold text-dark"><i class="bi bi-calendar3 text-primary me-1"></i>@Model.DataRegistro.ToString("dd/MM/yyyy 'às' HH:mm")</span>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.72rem;">Profissional Responsável</small>
                        <span class="fw-semibold text-dark"><i class="bi bi-person-check text-success me-1"></i>@profEv</span>
                    </div>
                    <div class="p-3 bg-light rounded-3 border">
                        <small class="text-muted d-block" style="font-size: 0.8rem;">
                            <i class="bi bi-shield-check text-success me-1"></i>Registro gravado e protegido com protocolo eletrônico no sistema NeuroSync.
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- CORPO DA ANOTAÇÃO CLÍNICA -->
        <div class="col-lg-8">
            <div class="card border-0 rounded-4 shadow-sm h-100">
                <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-journal-text text-primary me-2"></i>Registro e Anotações Clínicas da Sessão
                    </h6>
                    <span class="badge bg-light text-muted border rounded-pill px-3 py-1 small">
                        Visualização Detalhada
                    </span>
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div class="p-4 bg-light bg-opacity-50 rounded-4 border text-dark" style="white-space: pre-wrap; line-height: 1.8; font-size: 1.02rem; min-height: 280px;">@Model.Anotacao</div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2 text-muted small">
                        <div>
                            <i class="bi bi-fingerprint text-secondary me-1"></i>Protocolo Digital: <strong>@protocoloDigital</strong>
                        </div>
                        <div>
                            <i class="bi bi-check2-circle text-success me-1"></i>Registro Clínico Oficial - NeuroSync
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
