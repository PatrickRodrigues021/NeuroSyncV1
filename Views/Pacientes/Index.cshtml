@model IEnumerable<NeuroSync.Models.Paciente>

@{
    ViewData["Title"] = "Pacientes";
}

<style>
    /* Estilo do Cartão Principal */
    .card-table {
        background-color: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    }
    
    /* Estilos da Tabela */
    .table-custom { margin-bottom: 0; vertical-align: middle; }
    .table-custom thead th {
        border-bottom: 1px solid #f1f5f9;
        color: var(--text-muted);
        font-weight: 600;
        font-size: 0.85rem;
        padding: 16px 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .table-custom tbody tr { border-bottom: 1px solid #f8fafc; transition: 0.2s; }
    .table-custom tbody tr:hover { background-color: #f8fafc; }
    .table-custom td { padding: 16px 8px; color: var(--text-dark); font-weight: 500; font-size: 0.95rem; }
    
    /* Bolinha com a Inicial do Nome */
    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: #eef2ff;
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.1rem;
    }
    
    /* Barra de Busca */
    .search-box { position: relative; width: 300px; }
    .search-box input {
        border-radius: 20px;
        padding-left: 35px;
        border: 1px solid #e2e8f0;
        background-color: #f8fafc;
    }
    .search-box i {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
    }
</style>

<div class="pt-3">
    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: var(--text-dark);">Pacientes</h3>
            <p class="text-muted fw-bold mb-0">Gerencie os cadastros da clínica.</p>
        </div>
        <div class="d-flex gap-3 align-items-center">
            
            <!-- Barra de Busca -->
            <form asp-action="Index" method="get" class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" name="termoBusca" class="form-control" placeholder="Buscar paciente..." value="@ViewBag.BuscaAtual">
            </form>
            
            <a asp-action="Create" class="btn btn-primary fw-bold rounded-pill px-4">
                <i class="bi bi-plus-lg me-1"></i> Novo
            </a>
        </div>
    </div>

    <!-- Tabela -->
    <div class="card-table p-4">
        <div class="table-responsive">
            <table class="table table-custom">
                <thead>
                    <tr>
                        <th>Paciente</th>
                        <th>Idade / Nascimento</th>
                        <th>Responsável</th>
                        <th>Cadastrado Em</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle me-3">
                                            @item.Nome.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold">@item.Nome</h6>
                                            <small class="text-muted">ID: #@item.IdPaciente.ToString("D4")</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">
                                        @{
                                            var idade = DateTime.Today.Year - item.DataNascimento.Year;
                                            if (item.DataNascimento.Date > DateTime.Today.AddYears(-idade)) idade--;
                                        }
                                        @idade anos
                                    </div>
                                    <small class="text-muted">@item.DataNascimento.ToString("dd/MM/yyyy")</small>
                                </td>
                                
                                <td>
                                @{
                                    var nomeResponsavel = "-";
                                    if (!string.IsNullOrWhiteSpace(item.Responsavel)) {
                                        nomeResponsavel = item.Responsavel;
                                    } else if (!string.IsNullOrWhiteSpace(item.NomeMae)) {
                                        nomeResponsavel = item.NomeMae;
                                    } else if (!string.IsNullOrWhiteSpace(item.NomePai)) {
                                        nomeResponsavel = item.NomePai;
                                    }
                                }
                                @nomeResponsavel
                                </td>
                                <td>@item.CriadoEm.ToString("dd/MM/yyyy")</td>

                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.IdPaciente" class="btn btn-sm btn-light text-muted me-2 rounded-circle" title="Editar">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.IdPaciente" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold">
                                        Abrir Prontuário
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 mb-3 d-block"></i>
                                <h6 class="fw-bold">Nenhum paciente encontrado.</h6>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>