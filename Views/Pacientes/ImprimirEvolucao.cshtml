@model NeuroSync.Models.Evolucao
@{
    Layout = null;

    var codigoEvolucao = $"#EV{Model.IdEvolucao:D4}";
    var codigoPaciente = $"#{Model.PacienteId:D4}";
    var protocoloDigital = $"EV-{Model.IdEvolucao}-{(Model.DataRegistro.Ticks.ToString().Length >= 8 ? Model.DataRegistro.Ticks.ToString().Substring(0, 8) : Model.DataRegistro.Ticks.ToString())}";

    var paciente = Model.Paciente;
    var idade = 0;
    if (paciente != null)
    {
        idade = DateTime.Today.Year - paciente.DataNascimento.Year;
        if (paciente.DataNascimento.Date > DateTime.Today.AddYears(-idade)) idade--;
    }

    var tipoEv = string.IsNullOrWhiteSpace(Model.TipoEvolucao) ? "Sessão Terapêutica" : Model.TipoEvolucao;
    var profEv = string.IsNullOrWhiteSpace(Model.ProfissionalNome) ? "Profissional Clínico" : Model.ProfissionalNome;

    var responsavel = paciente != null
        ? (!string.IsNullOrWhiteSpace(paciente.Responsavel) ? paciente.Responsavel :
           !string.IsNullOrWhiteSpace(paciente.NomeMae) ? paciente.NomeMae :
           !string.IsNullOrWhiteSpace(paciente.NomePai) ? paciente.NomePai : "Não informado")
        : "Não informado";
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Evolução_@(paciente?.Nome.Replace(" ", "_") ?? "Paciente")_@codigoEvolucao.Replace("#", "")</title>
    <link rel="icon" type="image/png" href="~/images/logo-principal-cerebro-coracao 2.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --navy: #071A3A;
            --primary: #315BEF;
            --text-dark: #1e293b;
            --text-muted: #64748b;
        }

        body {
            font-family: 'Plus Jakarta Sans', 'Segoe UI', Arial, sans-serif;
            color: var(--text-dark);
            background-color: #f8fafc;
            margin: 0;
            padding: 0;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        /* BARRA SUPERIOR DE AÇÕES (APENAS NA TELA) */
        .print-toolbar {
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 12px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        /* FOLHA A4 SIMULADA NA TELA */
        .paper-container {
            max-width: 210mm;
            min-height: 297mm;
            margin: 24px auto;
            background: #ffffff;
            padding: 24mm 22mm;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
            position: relative;
            box-sizing: border-box;
        }

        /* ESTILOS TIMBRADOS */
        .clinic-brand {
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -0.5px;
            line-height: 1.1;
        }
        .clinic-brand .brand-neuro { color: var(--navy); }
        .clinic-brand .brand-sync { color: var(--primary); }

        .clinic-subtitle {
            font-size: 11px;
            color: #475569;
            font-weight: 600;
            margin-top: 3px;
        }

        .clinic-subinfo {
            font-size: 9.5px;
            color: #64748b;
        }

        .doc-title {
            font-size: 15px;
            font-weight: 800;
            color: var(--navy);
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .header-line {
            height: 3px;
            background: linear-gradient(90deg, var(--primary) 0%, #60a5fa 100%);
            border-radius: 2px;
            margin: 16px 0 20px 0;
        }

        .meta-box {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 14px 18px;
            margin-bottom: 22px;
        }

        .meta-title {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            color: #64748b;
            letter-spacing: 0.5px;
            margin-bottom: 2px;
        }

        .meta-value {
            font-size: 13px;
            font-weight: 600;
            color: #0f172a;
        }

        .section-heading {
            font-size: 12px;
            font-weight: 800;
            color: var(--navy);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 6px;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .evolution-content {
            font-size: 13.5px;
            line-height: 1.8;
            color: #1e293b;
            white-space: pre-wrap;
            text-align: justify;
            min-height: 200px;
            padding: 16px;
            background: #ffffff;
            border: 1px solid #f1f5f9;
            border-left: 4px solid var(--primary);
            border-radius: 6px;
            margin-bottom: 40px;
        }

        .signature-section {
            margin-top: 50px;
            page-break-inside: avoid;
        }

        .signature-line {
            width: 260px;
            border-top: 1px solid #334155;
            margin: 0 auto 6px auto;
        }

        .footer-note {
            font-size: 9.5px;
            color: #94a3b8;
            text-align: center;
            border-top: 1px solid #e2e8f0;
            padding-top: 12px;
            margin-top: 30px;
        }

        /* REGRAS DE IMPRESSÃO */
        @@media print {
            body {
                background: #ffffff !important;
            }
            .print-toolbar {
                display: none !important;
            }
            .paper-container {
                max-width: 100% !important;
                width: 100% !important;
                margin: 0 !important;
                padding: 10mm 15mm !important;
                border: none !important;
                box-shadow: none !important;
                border-radius: 0 !important;
                min-height: auto !important;
            }
            @@page {
                size: A4 portrait;
                margin: 10mm 15mm;
            }
        }
    </style>
</head>
<body>

    <!-- TOOLBAR (NÃO APARECE NA IMPRESSÃO) -->
    <div class="print-toolbar">
        <div class="d-flex align-items-center gap-2">
            <a href="javascript:window.close()" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-x-circle me-1"></i>Fechar
            </a>
            <span class="text-muted small ms-2 d-none d-sm-inline">Visualização de Impressão Timbrada</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/Pacientes/GerarEvolucaoPdf/@Model.IdEvolucao" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i>Baixar PDF Oficial
            </a>
            <button type="button" onclick="window.print()" class="btn btn-sm btn-primary rounded-pill px-4 fw-bold shadow-sm">
                <i class="bi bi-printer-fill me-1"></i>Imprimir Documento
            </button>
        </div>
    </div>

    <!-- FOLHA TIMBRADA A4 -->
    <div class="paper-container">

        <!-- CABEÇALHO COM IDENTIDADE VISUAL -->
        <div class="row align-items-center">
            <div class="col-8 d-flex align-items-center gap-3">
                <img src="~/images/logo-principal-cerebro-coracao 2.png" alt="NeuroSync" style="height: 52px; width: auto;" />
                <div>
                    <div class="clinic-brand">
                        <span class="brand-neuro">Neuro</span><span class="brand-sync">Sync</span>
                    </div>
                    <div class="clinic-subtitle">Clínica de Desenvolvimento e Neuropsicopedagogia</div>
                    <div class="clinic-subinfo">Atendimento Clínico Multidisciplinar Especializado</div>
                </div>
            </div>
            <div class="col-4 text-end">
                <div class="doc-title">Evolução Clínica</div>
                <div class="fw-bold text-primary small">Registro: @codigoEvolucao</div>
                <div class="text-muted" style="font-size: 10px;">Emissão: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <div class="header-line"></div>

        <!-- DADOS DO PACIENTE E SESSÃO -->
        <div class="meta-box">
            <div class="row g-2">
                <div class="col-7">
                    <div class="meta-title">Paciente</div>
                    <div class="meta-value">@(paciente?.Nome ?? "Paciente não informado")</div>
                </div>
                <div class="col-3">
                    <div class="meta-title">Nascimento / Idade</div>
                    <div class="meta-value">@(paciente?.DataNascimento.ToString("dd/MM/yyyy") ?? "-") (@idade anos)</div>
                </div>
                <div class="col-2 text-end">
                    <div class="meta-title">Prontuário</div>
                    <div class="meta-value">@codigoPaciente</div>
                </div>

                <div class="col-7 pt-2 border-top">
                    <div class="meta-title">Responsável</div>
                    <div class="meta-value" style="font-size: 12px;">@responsavel</div>
                </div>
                <div class="col-5 pt-2 border-top text-end">
                    <div class="meta-title">Tipo de Atendimento</div>
                    <div class="meta-value text-dark fw-bold" style="font-size: 12.5px;">@tipoEv</div>
                </div>

                <div class="col-6 pt-2 border-top">
                    <div class="meta-title">Data e Hora da Sessão</div>
                    <div class="meta-value"><i class="bi bi-calendar-event me-1"></i>@Model.DataRegistro.ToString("dd/MM/yyyy 'às' HH:mm")</div>
                </div>
                <div class="col-6 pt-2 border-top text-end">
                    <div class="meta-title">Profissional Responsável</div>
                    <div class="meta-value"><i class="bi bi-person-check me-1"></i>@profEv</div>
                </div>
            </div>
        </div>

        <!-- REGISTRO DA EVOLUÇÃO -->
        <div class="section-heading">
            <span><i class="bi bi-journal-text text-primary me-2"></i>Anotação e Condutas Clínicas da Sessão</span>
            <span class="text-muted fw-normal" style="font-size: 10px;">Documento Integrante do Prontuário</span>
        </div>

        <div class="evolution-content">@Model.Anotacao</div>

        <!-- ASSINATURA -->
        <div class="signature-section text-center">
            <div class="signature-line"></div>
            <div class="fw-bold text-dark" style="font-size: 13px;">@profEv</div>
            <div class="text-muted small" style="font-size: 11px;">Responsável Técnico / Atendimento Clínico</div>
            <div class="text-secondary small" style="font-size: 10px;">NeuroSync - Sistema de Gestão Multidisciplinar</div>
        </div>

        <!-- RODAPÉ -->
        <div class="footer-note">
            Este documento é de uso estritamente profissional e confidencial, protegido pelo sigilo profissional.
            <br />
            Registro Eletrônico: @protocoloDigital &bull; Gerado eletronicamente em @DateTime.Now.ToString("dd/MM/yyyy 'às' HH:mm")
        </div>

    </div>

    <!-- SCRIPT AUTO-PRINT -->
    <script>
        // Dispara a impressão automaticamente após o carregamento da página
        window.addEventListener('load', function() {
            setTimeout(function() {
                window.print();
            }, 600);
        });
    </script>
</body>
</html>
