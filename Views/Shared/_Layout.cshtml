<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NeuroSync</title>
    <link rel="icon" type="image/png" href="~/images/logo-principal-cerebro-coracao 2.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --navy: #071A3A;
            --primary: #315BEF;
            --bg-light: #f4f8fc; 
            --text-dark: #0b223d;
            --text-muted: #64748b;
        }

        body { 
            background-color: var(--bg-light); 
            color: var(--text-dark); 
            font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif; 
            margin: 0;
            overflow-x: hidden;
        }

        /* --- MENU LATERAL (SIDEBAR) --- */
        .sidebar { 
            width: 260px; 
            height: 100vh; 
            background-color: var(--navy); 
            position: fixed; 
            top: 0; 
            left: 0; 
            overflow-y: auto; 
            z-index: 1000;
        }

        .nav-link-custom { 
            color: rgba(255,255,255,0.7); 
            margin: 4px 14px; 
            border-radius: 10px; 
            padding: 12px 16px; 
            display: flex; 
            align-items: center; 
            gap: 12px; 
            font-weight: 500; 
            transition: all 0.25s ease; 
            text-decoration: none;
            font-size: 0.95rem;
            position: relative;
        }

        .nav-link-custom:hover { 
            color: white; 
            background-color: rgba(255,255,255,0.08); 
            transform: translateX(3px);
        }

        .nav-link-custom.active { 
            background: linear-gradient(135deg, rgba(49, 91, 239, 0.95) 0%, rgba(2, 132, 199, 0.95) 100%); 
            color: white; 
            font-weight: 600;
            box-shadow: 0 4px 16px rgba(49, 91, 239, 0.35);
        }

        .nav-link-custom.active::before {
            content: "";
            position: absolute;
            left: -14px;
            top: 6px;
            bottom: 6px;
            width: 4px;
            background: #38bdf8;
            border-radius: 0 4px 4px 0;
            box-shadow: 0 0 10px #38bdf8;
        }

        .nav-icon { font-size: 1.2rem; }

        /* --- ÁREA DE CONTEÚDO PRINCIPAL --- */
        .main-content { 
            margin-left: 260px; 
            min-height: 100vh; 
            padding: 30px 40px; 
        }
        
        /* Apaguei o CSS da Top-bar e da Search-bar antigas para limpar o código */
    </style>
</head>
<body>
    
    <!-- SIDEBAR -->
    <div class="sidebar d-flex flex-column py-4 shadow-lg">
        <!-- Logo -->
            <div class="d-flex flex-column align-items-center px-4 mb-5">

                <img src="~/images/logo-principal-cerebro-coracao 2.png"
                    alt="Logo NeuroSync"
                    class="mb-3"
                    style="height: 78px;
                            width: auto;
                            object-fit: contain;
                            filter: drop-shadow(0 0 10px rgba(49, 91, 239, 0.45));" />

                <h4 class="text-white fw-bold mb-0">
                    Neuro<span class="text-info">Sync</span>
                </h4>

            </div>
        
        <!-- Links de Navegação -->
        <nav class="flex-grow-1">
            @{
                // O C# descobre em qual tela (Controller) o usuário está agora
                var controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString();
            }

            <a href="/Home" class="nav-link-custom @(controllerAtual == "Home" ? "active" : "")">
                <i class="bi bi-grid-1x2-fill nav-icon"></i> Dashboard
            </a>
            
            <a href="/Pacientes" class="nav-link-custom @(controllerAtual == "Pacientes" ? "active" : "")">
                <i class="bi bi-person nav-icon"></i> Pacientes
            </a>
            
            <a href="/Agenda" class="nav-link-custom @(controllerAtual == "Agenda" ? "active" : "")">
                <i class="bi bi-calendar-event nav-icon"></i> Agenda
            </a>
            
            <a href="/Prontuarios" class="nav-link-custom @(controllerAtual == "Prontuarios" ? "active" : "")">
                <i class="bi bi-file-earmark-medical nav-icon"></i> Prontuários
            </a>
            
            <a href="/Terapias" class="nav-link-custom @(controllerAtual == "Terapias" ? "active" : "")">
                <i class="bi bi-puzzle nav-icon"></i> Terapias
            </a>
            
            <a href="/Relatorios" class="nav-link-custom @(controllerAtual == "Relatorios" ? "active" : "")">
                <i class="bi bi-bar-chart nav-icon"></i> Relatórios
            </a>
            
            <a href="/Financeiro" class="nav-link-custom @(controllerAtual == "Financeiro" ? "active" : "")">
                <i class="bi bi-wallet2 nav-icon"></i> Financeiro
            </a>
        </nav>

        <!-- Links de Rodapé -->
        <div class="mt-auto pt-3 border-top border-secondary border-opacity-25 px-2">
            <a href="/Configuracoes" class="nav-link-custom @(controllerAtual == "Configuracoes" ? "active" : "")">
                <i class="bi bi-gear nav-icon"></i> Configurações
            </a>
            <a href="/Login/Sair" class="nav-link-custom">
                <i class="bi bi-box-arrow-left nav-icon text-danger"></i> Sair
            </a>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        <!-- REMOVI A TOP-BAR AUTOMÁTICA DAQUI! Agora cada página tem seu próprio título. -->
        
        <!-- O miolo de cada página é injetado aqui dentro -->
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>