<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NeuroSync</title>
    <link rel="icon" type="image/png" href="~/images/logo-principal-cerebro-coracao 2.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --navy: #071A3A;
            --primary: #315BEF;
            --bg-light: #f4f8fc; 
            --text-dark: #0b223d;
            --text-muted: #64748b;
        }

        body { 
            background-color: var(--bg-light); 
            color: var(--text-dark); 
            font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif; 
            margin: 0;
            overflow-x: hidden;
        }

        /* --- MENU LATERAL (SIDEBAR) --- */
        .sidebar { 
            width: 250px; 
            height: 100vh; 
            background-color: var(--navy); 
            position: fixed; 
            top: 0; 
            left: 0; 
            overflow-y: auto; 
            z-index: 1040;
            transition: transform 0.3s ease;
        }

        /* Estilização suave da barra de rolagem da sidebar */
        .sidebar::-webkit-scrollbar {
            width: 5px;
        }
        .sidebar::-webkit-scrollbar-thumb {
            background-color: rgba(255,255,255,0.15);
            border-radius: 4px;
        }

        .nav-link-custom { 
            color: rgba(255,255,255,0.7); 
            margin: 4px 12px; 
            border-radius: 10px; 
            padding: 10px 14px; 
            display: flex; 
            align-items: center; 
            gap: 12px; 
            font-weight: 500; 
            transition: all 0.25s ease; 
            text-decoration: none;
            font-size: 0.92rem;
            position: relative;
        }

        .nav-link-custom:hover { 
            color: white; 
            background-color: rgba(255,255,255,0.08); 
            transform: translateX(3px);
        }

        .nav-link-custom.active { 
            background: linear-gradient(135deg, rgba(49, 91, 239, 0.95) 0%, rgba(2, 132, 199, 0.95) 100%); 
            color: white; 
            font-weight: 600;
            box-shadow: 0 4px 16px rgba(49, 91, 239, 0.35);
        }

        .nav-link-custom.active::before {
            content: "";
            position: absolute;
            left: -12px;
            top: 6px;
            bottom: 6px;
            width: 4px;
            background: #38bdf8;
            border-radius: 0 4px 4px 0;
            box-shadow: 0 0 10px #38bdf8;
        }

        .nav-icon { font-size: 1.15rem; }

        .user-sidebar-badge:hover {
            background: rgba(255, 255, 255, 0.18) !important;
            border-color: rgba(56, 189, 248, 0.45) !important;
            transform: translateY(-1px);
        }

        /* --- ÁREA DE CONTEÚDO PRINCIPAL --- */
        .main-content { 
            margin-left: 250px; 
            min-height: 100vh; 
            padding: clamp(16px, 2.5vw, 32px);
            width: calc(100% - 250px);
            max-width: 100%;
            transition: margin 0.3s ease, width 0.3s ease;
        }

        /* Topbar para telas menores (< 992px) */
        .mobile-header {
            display: none;
            background-color: var(--navy);
            padding: 12px 20px;
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .sidebar-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 1035;
        }

        /* Responsividade para telas menores que 992px (notebooks em meio-ecrã, tablets, smartphones) */
        @@media (max-width: 991.98px) {
            .mobile-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
            }
            .sidebar {
                transform: translateX(-100%);
            }
            .sidebar.show {
                transform: translateX(0);
            }
            .sidebar-backdrop.show {
                display: block;
            }
            .main-content {
                margin-left: 0;
                width: 100%;
                padding: 16px;
            }
        }

        /* Adaptação para monitores com altura reduzida (< 800px) */
        @@media (max-height: 800px) {
            .sidebar-brand-box {
                margin-bottom: 1.5rem !important;
            }
            .sidebar-brand-box img {
                height: 56px !important;
            }
            .nav-link-custom {
                padding: 8px 12px;
                margin: 2px 10px;
                font-size: 0.88rem;
            }
        }
    </style>
</head>
<body>
    
    <!-- HEADER PARA TELAS MENORES / DISPOSITIVOS COMPACTOS -->
    <header class="mobile-header shadow-sm">
        <button type="button" class="btn btn-outline-light btn-sm border-0 fs-4 py-0" id="sidebarToggle" aria-label="Abrir menu lateral">
            <i class="bi bi-list"></i>
        </button>
        <div class="d-flex align-items-center gap-2">
            <img src="~/images/logo-principal-cerebro-coracao 2.png" alt="Logo" style="height: 32px;" />
            <span class="text-white fw-bold fs-5">Neuro<span class="text-info">Sync</span></span>
        </div>
        <div style="width: 32px;"></div> <!-- Espaçador para centralizar a logo -->
    </header>

    <!-- BACKDROP PARA TELAS MENORES -->
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- SIDEBAR -->
    <div class="sidebar d-flex flex-column py-3 shadow-lg" id="appSidebar">
        <!-- Logo -->
        <div class="d-flex flex-column align-items-center px-4 mb-4 sidebar-brand-box">
            <img src="~/images/logo-principal-cerebro-coracao 2.png"
                alt="Logo NeuroSync"
                class="mb-2"
                style="height: 72px;
                        width: auto;
                        object-fit: contain;
                        filter: drop-shadow(0 0 10px rgba(49, 91, 239, 0.45));" />

            <h4 class="text-white fw-bold mb-0">
                Neuro<span class="text-info">Sync</span>
            </h4>
        </div>
        
        <!-- Links de Navegação -->
        <nav class="flex-grow-1">
            @{
                // O C# descobre em qual tela (Controller) o usuário está agora
                var controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString();
            }

            <a href="/Home" class="nav-link-custom @(controllerAtual == "Home" ? "active" : "")">
                <i class="bi bi-grid-1x2-fill nav-icon"></i> Dashboard
            </a>
            
            <a href="/Pacientes" class="nav-link-custom @(controllerAtual == "Pacientes" ? "active" : "")">
                <i class="bi bi-person nav-icon"></i> Pacientes
            </a>
            
            <a href="/Agenda" class="nav-link-custom @(controllerAtual == "Agenda" ? "active" : "")">
                <i class="bi bi-calendar-event nav-icon"></i> Agenda
            </a>
            
            <a href="/Prontuarios" class="nav-link-custom @(controllerAtual == "Prontuarios" ? "active" : "")">
                <i class="bi bi-file-earmark-medical nav-icon"></i> Prontuários
            </a>
            
            <a href="/Terapias" class="nav-link-custom @(controllerAtual == "Terapias" ? "active" : "")">
                <i class="bi bi-puzzle nav-icon"></i> Terapias
            </a>
            
            <a href="/Relatorios" class="nav-link-custom @(controllerAtual == "Relatorios" ? "active" : "")">
                <i class="bi bi-bar-chart nav-icon"></i> Relatórios
            </a>
            
            <a href="/Financeiro" class="nav-link-custom @(controllerAtual == "Financeiro" ? "active" : "")">
                <i class="bi bi-wallet2 nav-icon"></i> Financeiro
            </a>
        </nav>

        <!-- Links de Rodapé -->
        <div class="mt-auto pt-3 border-top border-secondary border-opacity-25 px-2">
            @if (User?.Identity?.IsAuthenticated == true)
            {
                var nomeUsuario = User.Identity.Name ?? "Usuário";
                var primeiroNome = nomeUsuario.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Usuário";
                var inicial = string.IsNullOrEmpty(primeiroNome) ? "U" : primeiroNome.Substring(0, 1).ToUpper();

                <a href="/Configuracoes" class="d-flex align-items-center gap-2 px-3 py-2 mb-2 rounded-3 text-decoration-none bg-white bg-opacity-10 border border-white border-opacity-10 text-white shadow-sm user-sidebar-badge" style="transition: all 0.2s ease;" title="Abrir Configurações da Conta">
                    <div class="d-flex align-items-center justify-content-center rounded-circle bg-info text-dark fw-bold" style="width: 32px; height: 32px; font-size: 0.85rem; flex-shrink: 0;">
                        @inicial
                    </div>
                    <div class="text-truncate" style="min-width: 0;">
                        <div class="fw-bold text-white text-truncate" style="font-size: 0.82rem; line-height: 1.2;">@nomeUsuario</div>
                        <div class="text-info" style="font-size: 0.70rem; line-height: 1.2;">
                            <i class="bi bi-circle-fill text-success" style="font-size: 0.45rem;"></i> Online
                        </div>
                    </div>
                </a>
            }

            <a href="/Configuracoes" class="nav-link-custom @(controllerAtual == "Configuracoes" ? "active" : "")">
                <i class="bi bi-gear nav-icon"></i> Configurações
            </a>
            <a href="/Login/Sair" class="nav-link-custom">
                <i class="bi bi-box-arrow-left nav-icon text-danger"></i> Sair
            </a>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        <!-- O miolo de cada página é injetado aqui dentro -->
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Toggle da Sidebar para telas menores
        const sidebarToggle = document.getElementById('sidebarToggle');
        const appSidebar = document.getElementById('appSidebar');
        const sidebarBackdrop = document.getElementById('sidebarBackdrop');

        if (sidebarToggle && appSidebar && sidebarBackdrop) {
            function toggleSidebar() {
                appSidebar.classList.toggle('show');
                sidebarBackdrop.classList.toggle('show');
            }

            sidebarToggle.addEventListener('click', toggleSidebar);
            sidebarBackdrop.addEventListener('click', toggleSidebar);
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>