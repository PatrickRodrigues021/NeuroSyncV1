@* ========================================================================= *@
@* MODAL: REABRIR COBRANÇA DE PACIENTE                                       *@
@* ========================================================================= *@
<div class="modal fade" id="modalReabrir" tabindex="-1" aria-labelledby="modalReabrirLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 bg-warning-subtle text-dark p-4 pb-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-warning bg-opacity-25 p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="bi bi-arrow-counterclockwise fs-4 text-dark"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="modalReabrirLabel">Reabrir Cobrança</h5>
                        <small class="text-muted">Reverter status de Pago para Pendente</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            
            <form method="post" action="/Financeiro/Reabrir" id="formReabrir">
                <input type="hidden" name="id" id="reabrirIdCobranca" value="" />
                
                <div class="modal-body p-4 pt-3">
                    <p class="text-secondary mb-3">
                        Tem certeza de que deseja reabrir esta cobrança?
                    </p>
                    
                    <div class="bg-light p-3 rounded-3 border mb-3">
                        <div class="d-flex justify-content-between mb-1 small text-muted">
                            <span>Paciente:</span>
                            <strong class="text-dark" id="reabrirNomePaciente">—</strong>
                        </div>
                        <div class="d-flex justify-content-between small text-muted">
                            <span>Valor:</span>
                            <strong class="text-success" id="reabrirValorCobranca">—</strong>
                        </div>
                    </div>

                    <div class="alert alert-warning border-0 bg-warning-subtle text-dark small mb-0 rounded-3 d-flex gap-2">
                        <i class="bi bi-info-circle-fill text-warning flex-shrink-0 mt-1"></i>
                        <div>
                            A data de pagamento será removida e o valor deixará de constar como receita liquidada até uma nova baixa.
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 p-4 pt-0 d-flex justify-content-between">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-bold border" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold text-dark shadow-sm">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reabrir Cobrança
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    public static string ObterClasseCategoria(string categoria)
    {
        return categoria switch
        {
            "Energia Elétrica" => "cat-luz",
            "Água" => "cat-agua",
            "Telefonia" => "cat-telefonia",
            "Internet" => "cat-internet",
            "Material de Escritório" => "cat-material",
            "Sistemas" => "cat-sistemas",
            "Aluguel" => "cat-aluguel",
            "Limpeza" => "cat-limpeza",
            _ => "cat-outros"
        };
    }

    public static string ObterIconeCategoria(string categoria)
    {
        return categoria switch
        {
            "Energia Elétrica" => "bi-lightning-charge-fill",
            "Água" => "bi-droplet-fill",
            "Telefonia" => "bi-telephone-fill",
            "Internet" => "bi-wifi",
            "Material de Escritório" => "bi-box-seam-fill",
            "Sistemas" => "bi-laptop",
            "Aluguel" => "bi-building",
            "Limpeza" => "bi-brush-fill",
            _ => "bi-tag-fill"
        };
    }
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            @if (Model.AbaAtiva == "Resumo")
            {
                <text>
                // ==========================================
                // 1. GRÁFICO DE BARRAS: RECEITA X DESPESAS
                // ==========================================
                const canvasRecDesp = document.getElementById('graficoReceitaDespesas');
                if (canvasRecDesp) {
                    const ctxRecDesp = canvasRecDesp.getContext('2d');
                    const labelsMeses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MesesLabels));
                    const dadosReceitas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReceitasMensais));
                    const dadosDespesas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DespesasMensais));

                    new Chart(ctxRecDesp, {
                        type: 'bar',
                        data: {
                            labels: labelsMeses,
                            datasets: [
                                {
                                    label: 'Receitas',
                                    data: dadosReceitas,
                                    backgroundColor: '#10B981',
                                    borderRadius: 6,
                                    barPercentage: 0.6,
                                    categoryPercentage: 0.5
                                },
                                {
                                    label: 'Despesas',
                                    data: dadosDespesas,
                                    backgroundColor: '#EF4444',
                                    borderRadius: 6,
                                    barPercentage: 0.6,
                                    categoryPercentage: 0.5
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            return ' ' + context.dataset.label + ': ' + Number(context.raw).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                                        }
                                    }
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        color: '#94A3B8',
                                        font: { family: "'Plus Jakarta Sans', sans-serif", size: 11 },
                                        callback: function (value) {
                                            if (value >= 1000) return (value / 1000) + 'k';
                                            return value;
                                        }
                                    },
                                    grid: { color: '#F1F5F9', drawBorder: false },
                                    border: { display: false }
                                },
                                x: {
                                    ticks: {
                                        color: '#64748B',
                                        font: { family: "'Plus Jakarta Sans', sans-serif", size: 12, weight: '600' }
                                    },
                                    grid: { display: false },
                                    border: { display: false }
                                }
                            }
                        }
                    });
                }

                // ==========================================
                // 2. GRÁFICO DONUT: DESPESAS POR CATEGORIA
                // ==========================================
                const canvasCat = document.getElementById('graficoDespesasCategorias');
                if (canvasCat) {
                    const ctxCat = canvasCat.getContext('2d');
                    const catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoriasLabels));
                    const catValores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoriasValores));

                    const cores = [
                        '#F59E0B', '#06B6D4', '#10B981', '#6366F1', 
                        '#F97316', '#8B5CF6', '#EF4444', '#14B8A6', '#64748B'
                    ];

                    new Chart(ctxCat, {
                        type: 'doughnut',
                        data: {
                            labels: catLabels,
                            datasets: [{
                                data: catValores,
                                backgroundColor: cores.slice(0, catLabels.length),
                                borderWidth: 0,
                                hoverOffset: 4
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            cutout: '68%',
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            return ' ' + context.label + ': ' + Number(context.raw).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                                        }
                                    }
                                }
                            }
                        }
                    });
                }
                </text>
            }

        });

        // ==========================================
        // FUNÇÕES MODAIS DE DESPESAS
        // ==========================================
        function abrirModalNovaDespesa() {
            document.getElementById('formNovaDespesa').reset();
            document.getElementById('despesaVencimento').value = new Date().toISOString().split('T')[0];
            document.getElementById('boxDataPagamentoDespesa').style.display = 'none';
            const modalEl = document.getElementById('modalNovaDespesa');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }

        function abrirModalComCategoria(categoria) {
            abrirModalNovaDespesa();
            const selectCat = document.getElementById('despesaCategoria');
            if (selectCat) {
                selectCat.value = categoria;
            }
        }

        function toggleDataPagamentoDespesa(status) {
            const box = document.getElementById('boxDataPagamentoDespesa');
            if (box) {
                box.style.display = status === 'Pago' ? 'block' : 'none';
            }
        }

        function abrirModalBaixarDespesa(id, descricao, valor) {
            document.getElementById('baixarIdDespesa').value = id;
            document.getElementById('baixarDescricaoDespesa').textContent = descricao;
            document.getElementById('baixarValorDespesa').textContent = valor;
            const modalEl = document.getElementById('modalBaixarDespesa');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }

        function abrirModalReabrirDespesa(id, descricao, valor) {
            document.getElementById('reabrirIdDespesa').value = id;
            document.getElementById('reabrirDescricaoDespesa').textContent = descricao;
            document.getElementById('reabrirValorDespesa').textContent = valor;
            const modalEl = document.getElementById('modalReabrirDespesa');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }

        function abrirModalExcluirDespesa(id, descricao) {
            document.getElementById('excluirIdDespesa').value = id;
            document.getElementById('excluirDescricaoDespesa').textContent = descricao;
            const modalEl = document.getElementById('modalExcluirDespesa');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }

        // ==========================================
        // FUNÇÕES MODAIS DE COBRANÇAS
        // ==========================================
        function abrirModalReabrir(id, nomePaciente, valor) {
            document.getElementById('reabrirIdCobranca').value = id;
            document.getElementById('reabrirNomePaciente').textContent = nomePaciente;
            document.getElementById('reabrirValorCobranca').textContent = valor;
            const modalEl = document.getElementById('modalReabrir');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }
    </script>
}
