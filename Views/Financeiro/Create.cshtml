@model NeuroSync.Models.Cobranca

@{
    ViewData["Title"] = "Nova Cobrança";
}

<style>
    .finance-create-wrapper {
        padding-top: 0.5rem;
        padding-bottom: 3rem;
    }

    .page-header-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.85rem;
        font-weight: 800;
        color: #0F172A;
        letter-spacing: -0.5px;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .page-title-icon {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        background: linear-gradient(135deg, #2563EB 0%, #0284C7 100%);
        color: #FFFFFF;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.25);
    }

    .page-subtitle {
        color: #64748B;
        font-size: 0.95rem;
        font-weight: 500;
        margin-bottom: 0;
    }

    .card-modern-form {
        background: #FFFFFF;
        border-radius: 20px;
        border: 1px solid rgba(226, 232, 240, 0.85);
        box-shadow: 0 8px 30px rgba(15, 23, 42, 0.035);
        padding: clamp(20px, 3vw, 36px);
    }

    .form-section-title {
        font-size: 1rem;
        font-weight: 700;
        color: #0F172A;
        letter-spacing: -0.2px;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid #F1F5F9;
    }

    .form-section-title i {
        color: #2563EB;
        font-size: 1.15rem;
    }

    .form-label-custom {
        font-weight: 700;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: #475569;
        margin-bottom: 8px;
        display: block;
    }

    .input-custom, .form-select-custom {
        border-radius: 12px;
        border: 1px solid #E2E8F0;
        padding: 12px 16px;
        background-color: #F8FAFC;
        font-size: 0.95rem;
        color: #1E293B;
        font-weight: 500;
        transition: all 0.2s ease;
        width: 100%;
    }

    .input-custom:focus, .form-select-custom:focus {
        border-color: #2563EB;
        background-color: #FFFFFF;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
        outline: none;
    }

    .currency-input-group {
        position: relative;
        display: flex;
        align-items: center;
    }

    .currency-prefix {
        position: absolute;
        left: 16px;
        font-weight: 700;
        color: #64748B;
        font-size: 1rem;
        pointer-events: none;
    }

    .input-currency {
        padding-left: 46px;
        font-size: 1.2rem;
        font-weight: 700;
        color: #0F172A;
    }

    .quick-chips-wrapper {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 8px;
    }

    .quick-chip-btn {
        background: #F1F5F9;
        border: 1px solid #E2E8F0;
        border-radius: 50px;
        padding: 6px 14px;
        font-size: 0.8rem;
        font-weight: 600;
        color: #475569;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .quick-chip-btn:hover {
        background: #E0F2FE;
        border-color: #BAE6FD;
        color: #0284C7;
        transform: translateY(-1px);
    }

    .invoice-preview-card {
        background: linear-gradient(145deg, #FFFFFF 0%, #F8FAFC 100%);
        border-radius: 20px;
        border: 1px solid rgba(226, 232, 240, 0.85);
        box-shadow: 0 8px 30px rgba(15, 23, 42, 0.035);
        padding: 24px;
        position: sticky;
        top: 24px;
    }

    .preview-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        padding-bottom: 14px;
        border-bottom: 1px dashed #CBD5E1;
    }

    .preview-badge-status {
        background: #FEF3C7;
        color: #92400E;
        border: 1px solid #FCD34D;
        font-size: 0.76rem;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 50px;
    }

    .preview-value-box {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 14px;
        padding: 16px;
        text-align: center;
        margin-bottom: 18px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    }

    .preview-value-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: #64748B;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 2px;
    }

    .preview-value-amount {
        font-size: 1.85rem;
        font-weight: 800;
        color: #059669;
        line-height: 1.1;
    }

    .preview-info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        font-size: 0.86rem;
        border-bottom: 1px solid #F1F5F9;
    }

    .preview-info-label {
        color: #64748B;
        font-weight: 500;
    }

    .preview-info-val {
        color: #0F172A;
        font-weight: 700;
        text-align: right;
        max-width: 60%;
        word-break: break-word;
    }

    .info-tip-card {
        background: #EFF6FF;
        border: 1px solid #BFDBFE;
        border-radius: 14px;
        padding: 14px 16px;
        margin-top: 18px;
        display: flex;
        gap: 12px;
        font-size: 0.84rem;
        color: #1E40AF;
        line-height: 1.45;
    }

    .info-tip-card i {
        font-size: 1.25rem;
        color: #2563EB;
        flex-shrink: 0;
    }
</style>

<div class="finance-create-wrapper">

    <div class="page-header-box">
        <div>
            <div class="page-title">
                <div class="page-title-icon">
                    <i class="bi bi-wallet2"></i>
                </div>
                <span>Nova Cobrança</span>
            </div>
            <p class="page-subtitle">Cadastre uma nova fatura, mensalidade ou sessão avulsa para controle financeiro.</p>
        </div>

        <a href="/Financeiro" class="btn btn-light fw-bold text-muted rounded-pill px-4 border shadow-sm">
            <i class="bi bi-arrow-left me-2"></i> Voltar ao Financeiro
        </a>
    </div>

    <form asp-action="Create" method="post" id="formCobranca">
        <div class="row g-4">
            
            <div class="col-12 col-lg-8">
                <div class="card-modern-form">
                    
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger fw-bold rounded-3 mb-4"></div>

                    <div class="form-section-title">
                        <i class="bi bi-person-fill"></i>
                        <span>Paciente & Responsável</span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PacienteId" class="form-label-custom">Paciente (Pagador) *</label>
                        <select asp-for="PacienteId" id="buscaPaciente" class="form-select-custom" asp-items="ViewBag.Pacientes" required>
                            <option value="">-- Selecione ou digite o nome do paciente... --</option>
                        </select>
                        <span class="text-muted small mt-1 d-block">
                            <i class="bi bi-info-circle me-1"></i> A cobrança será vinculada ao prontuário e histórico deste paciente.
                        </span>
                    </div>

                    <div class="form-section-title mt-4">
                        <i class="bi bi-receipt"></i>
                        <span>Detalhes da Fatura</span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Descricao" class="form-label-custom">Descrição da Cobrança *</label>
                        <input asp-for="Descricao" id="inputDescricao" class="input-custom" placeholder="Ex: Mensalidade de Setembro ou Sessão Avulsa 18/09" required />
                        
                        <div class="quick-chips-wrapper">
                            <span class="text-muted small align-self-center me-1" style="font-size: 0.75rem;">Sugestões:</span>
                            <button type="button" class="quick-chip-btn" data-type="descricao" data-value="Mensalidade">
                                <i class="bi bi-calendar-check"></i> Mensalidade do Mês
                            </button>
                            <button type="button" class="quick-chip-btn" data-type="descricao" data-value="Sessão Avulsa de Terapia">
                                <i class="bi bi-puzzle"></i> Sessão Avulsa
                            </button>
                            <button type="button" class="quick-chip-btn" data-type="descricao" data-value="Avaliação Neuropsicológica">
                                <i class="bi bi-activity"></i> Avaliação Neuro
                            </button>
                            <button type="button" class="quick-chip-btn" data-type="descricao" data-value="Pacote de 4 Sessões">
                                <i class="bi bi-collection"></i> Pacote 4 Sessões
                            </button>
                        </div>
                    </div>

                    <div class="form-section-title mt-4">
                        <i class="bi bi-currency-dollar"></i>
                        <span>Valores & Prazos</span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-6">
                            <label asp-for="Valor" class="form-label-custom">Valor Total (R\$) *</label>
                            <div class="currency-input-group">
                                <span class="currency-prefix">R\$</span>
                                <input asp-for="Valor" id="inputValor" type="number" step="0.01" min="0.01" class="input-custom input-currency" placeholder="150,00" required />
                            </div>
                            
                            <div class="quick-chips-wrapper">
                                <button type="button" class="quick-chip-btn" data-type="valor" data-value="120">R\$ 120</button>
                                <button type="button" class="quick-chip-btn" data-type="valor" data-value="150">R\$ 150</button>
                                <button type="button" class="quick-chip-btn" data-type="valor" data-value="200">R\$ 200</button>
                                <button type="button" class="quick-chip-btn" data-type="valor" data-value="450">R\$ 450</button>
                                <button type="button" class="quick-chip-btn" data-type="valor" data-value="600">R\$ 600</button>
                            </div>
                        </div>
                        
                        <div class="col-12 col-md-6">
                            <label asp-for="DataVencimento" class="form-label-custom">Data de Vencimento *</label>
                            <input asp-for="DataVencimento" id="inputDataVencimento" type="date" class="input-custom" required />
                            
                            <div class="quick-chips-wrapper">
                                <button type="button" class="quick-chip-btn" data-type="vencimento" data-value="0">Hoje</button>
                                <button type="button" class="quick-chip-btn" data-type="vencimento" data-value="7">+7 dias</button>
                                <button type="button" class="quick-chip-btn" data-type="vencimento" data-value="15">+15 dias</button>
                                <button type="button" class="quick-chip-btn" data-type="vencimento" data-value="fim_mes">Fim do Mês</button>
                            </div>
                        </div>
                    </div>

                    <input type="hidden" asp-for="Status" value="Pendente" />

                    <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top">
                        <a href="/Financeiro" class="btn btn-light fw-bold text-muted px-4 py-2 rounded-pill border">
                            Cancelar
                        </a>

                        <button type="submit" class="btn btn-primary fw-bold px-4 py-2 rounded-pill shadow-sm d-inline-flex align-items-center gap-2" style="background-color: #2563EB; border-color: #2563EB;">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Gerar Cobrança</span>
                        </button>
                    </div>

                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="invoice-preview-card">
                    
                    <div class="preview-header">
                        <div class="d-flex align-items-center gap-2">
                            <img src="~/images/logo-principal-cerebro-coracao 2.png" alt="Logo" style="height: 28px;" />
                            <span class="fw-bold text-dark" style="font-size: 0.95rem;">Neuro<span class="text-primary">Sync</span></span>
                        </div>
                        <span class="preview-badge-status">
                            <i class="bi bi-clock-history me-1"></i>Pendente
                        </span>
                    </div>

                    <div class="preview-value-box">
                        <div class="preview-value-label">Valor a Receber</div>
                        <div class="preview-value-amount" id="previewValor">R\$ 0,00</div>
                    </div>

                    <div>
                        <div class="preview-info-row">
                            <span class="preview-info-label">Paciente</span>
                            <span class="preview-info-val text-primary" id="previewPaciente">—</span>
                        </div>

                        <div class="preview-info-row">
                            <span class="preview-info-label">Descrição</span>
                            <span class="preview-info-val" id="previewDescricao">—</span>
                        </div>

                        <div class="preview-info-row">
                            <span class="preview-info-label">Vencimento</span>
                            <span class="preview-info-val text-danger" id="previewDataVencimento">—</span>
                        </div>

                        <div class="preview-info-row border-0">
                            <span class="preview-info-label">Status Inicial</span>
                            <span class="preview-info-val text-warning fw-bold">Aguardando Baixa</span>
                        </div>
                    </div>

                    <div class="info-tip-card">
                        <i class="bi bi-shield-check"></i>
                        <div>
                            <strong>Controle Integrado:</strong>
                            Após gerar a cobrança, você poderá dar baixa manual a qualquer momento ou vinculá-la aos relatórios mensais da clínica.
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </form>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const inputDesc = document.getElementById('inputDescricao');
            const inputValor = document.getElementById('inputValor');
            const inputData = document.getElementById('inputDataVencimento');
            const selectPaciente = document.getElementById('buscaPaciente');

            // Define data padrão de 7 dias se estiver vazia
            if (inputData && !inputData.value) {
                inputData.value = calcularData(7);
            }

            // Event Listeners nos campos para atualizar o card da direita
            if (selectPaciente) selectPaciente.addEventListener('change', atualizarPreview);
            if (inputDesc) inputDesc.addEventListener('input', atualizarPreview);
            if (inputValor) inputValor.addEventListener('input', atualizarPreview);
            if (inputData) inputData.addEventListener('change', atualizarPreview);

            // Escuta os cliques em TODOS os botões de sugestão
            document.querySelectorAll('.quick-chip-btn').forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    const type = this.getAttribute('data-type');
                    const val = this.getAttribute('data-value');

                    if (type === 'descricao') {
                        if (val === 'Mensalidade') {
                            inputDesc.value = 'Mensalidade de ' + obterMesAtual();
                        } else {
                            inputDesc.value = val;
                        }
                    } else if (type === 'valor') {
                        inputValor.value = parseFloat(val).toFixed(2);
                    } else if (type === 'vencimento') {
                        if (val === 'fim_mes') {
                            inputData.value = calcularFimDoMes();
                        } else {
                            inputData.value = calcularData(parseInt(val, 10));
                        }
                    }

                    atualizarPreview();
                });
            });

            atualizarPreview();

            function atualizarPreview() {
                // Paciente
                const previewPaciente = document.getElementById('previewPaciente');
                if (selectPaciente && previewPaciente) {
                    const textoSelected = selectPaciente.options[selectPaciente.selectedIndex]?.text || '';
                    previewPaciente.textContent = (textoSelected && !textoSelected.includes('--')) ? textoSelected : 'Não selecionado';
                }

                // Descrição
                const previewDesc = document.getElementById('previewDescricao');
                if (inputDesc && previewDesc) {
                    previewDesc.textContent = inputDesc.value.trim() || 'Sem descrição';
                }

                // Valor
                const previewValor = document.getElementById('previewValor');
                if (inputValor && previewValor) {
                    const v = parseFloat(inputValor.value);
                    if (!isNaN(v) && v > 0) {
                        previewValor.textContent = v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                    } else {
                        previewValor.textContent = 'R\$ 0,00';
                    }
                }

                // Vencimento
                const previewData = document.getElementById('previewDataVencimento');
                if (inputData && previewData) {
                    const d = inputData.value;
                    if (d) {
                        const partes = d.split('-');
                        previewData.textContent = partes.length === 3 ? `${partes[2]}/${partes[1]}/${partes[0]}` : d;
                    } else {
                        previewData.textContent = 'Não informada';
                    }
                }
            }

            function calcularData(diasAdicionais) {
                const data = new Date();
                data.setDate(data.getDate() + diasAdicionais);
                return formatarDataISO(data);
            }

            function calcularFimDoMes() {
                const data = new Date();
                const ultimoDia = new Date(data.getFullYear(), data.getMonth() + 1, 0);
                return formatarDataISO(ultimoDia);
            }

            function formatarDataISO(data) {
                const ano = data.getFullYear();
                const mes = String(data.getMonth() + 1).padStart(2, '0');
                const dia = String(data.getDate()).padStart(2, '0');
                return `${ano}-${mes}-${dia}`;
            }

            function obterMesAtual() {
                const meses = ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'];
                return meses[new Date().getMonth()];
            }
        });
    </script>
}