@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - NeuroSync</title>
    <link rel="icon" type="image/png" href="~/images/logo-principal-cerebro-coracao 2.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- CSS DO MAPLIBRE (Necessário para o OpenFreeMap) -->
    <link href="https://unpkg.com/maplibre-gl@3.x/dist/maplibre-gl.css" rel="stylesheet" />
    
    <style>
        :root {
            --navy: #071A3A;
            --navy-light: #102B55;
            --primary: #315BEF;
            --cyan: #16C4C8;
            --background: #F7F9FC;
            --text: #172554;
            --muted: #64748B;
        }

        body {
            background-color: var(--background);
            color: var(--text);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow-x: hidden;
            margin: 0;
            min-height: 100dvh;
        }

        /* --- ESTILOS DA BARRA LATERAL ESCURA --- */
        .bg-navy { background-color: var(--navy); }
        .text-cyan { color: var(--cyan); }
        
        .btn-primary-custom { background-color: var(--primary); border-color: var(--primary); color: white; transition: 0.3s; }
        .btn-primary-custom:hover { background-color: #2546c7; color: white; }

        .input-dark { background-color: var(--navy-light); border: 1px solid rgba(255,255,255,0.1); color: white; }
        .input-dark:focus { background-color: var(--navy-light); border-color: var(--cyan); color: white; box-shadow: none; }
        .input-dark::placeholder { color: #8ba3cb; font-size: 0.9rem; }
        
        .input-group-text-dark { background-color: var(--navy-light); border: 1px solid rgba(255,255,255,0.1); color: #8ba3cb; border-right: none; }
        .form-control.input-dark { border-left: none; }
        .form-check-input:checked { background-color: var(--primary); border-color: var(--primary); }

        /* Estilos Responsivos de Login */
        .login-page, .login-row {
            min-height: 100vh;
        }

        .login-sidebar {
            min-height: 100vh;
            max-height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .login-sidebar::-webkit-scrollbar {
            width: 5px;
        }

        .login-sidebar::-webkit-scrollbar-thumb {
            background-color: rgba(255, 255, 255, 0.2);
            border-radius: 4px;
        }

        .login-content {
            height: 100vh;
            overflow: hidden;
        }

        #mapa-clinica {
            height: clamp(120px, 16vh, 180px);
            width: 100%;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.1);
        }

        /* Adaptação para monitores com altura reduzida (< 850px ou zoom 125%/150%) */
        @@media (max-height: 850px) {
            .login-sidebar {
                padding: clamp(1rem, 2.5vh, 2rem) !important;
            }
            .login-logo-img {
                height: 70px !important;
                margin-bottom: 0.5rem !important;
            }
            .login-header-text {
                margin-bottom: 1.25rem !important;
                font-size: 0.95rem !important;
            }
            .login-form-area {
                margin-bottom: 1.5rem !important;
            }
            .login-form-area .mb-4 {
                margin-bottom: 0.85rem !important;
            }
            .login-footer-security {
                margin-bottom: 0.85rem !important;
                padding-bottom: 0.85rem !important;
            }
        }

        @@media (max-width: 1200px) {
            .login-content h1 {
                font-size: 2.2rem !important;
            }
            .login-content p {
                font-size: 1.05rem !important;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid p-0 login-page">
        <div class="row g-0 login-page login-row">

            <!-- ========================================== -->
            <!-- COLUNA ESQUERDA: LOGIN                     -->
            <!-- ========================================== -->
            <div class="col-12 col-lg-5 col-xl-4 bg-navy d-flex flex-column justify-content-between p-4 p-md-5 shadow-lg position-relative z-3 login-sidebar">
                
                <div class="text-center">
                    <div class="d-flex flex-column align-items-center mb-3 mt-2">
                        <img src="~/images/logo-principal-cerebro-coracao 2.png"
                             alt="Logo NeuroSync"
                             class="mb-3 login-logo-img"
                             style="height: 100px;
                                    width: auto;
                                    object-fit: contain;
                                    filter: drop-shadow(0 0 12px rgba(22, 196, 200, 0.45));" />

                        <h2 class="text-white fw-bold mb-0">
                            Neuro<span class="text-cyan">Sync</span>
                        </h2>
                    </div>

                    <p class="text-white-50 mb-4 mx-auto login-header-text"
                       style="max-width: 400px;
                              font-size: 1.05rem;
                              line-height: 1.55;">
                        Gestão Clínica &amp; Prontuário Eletrônico do Paciente (PEP)
                    </p>
                </div>

                <div class="mb-4 login-form-area">
                    <form method="post" action="/Login/Entrar">
                        @Html.AntiForgeryToken()
                        @if (ViewBag.Erro != null)
                        {
                            <div class="alert alert-danger text-center small fw-bold py-2 mb-3">
                                <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.Erro
                            </div>
                        }
                        
                        <div class="mb-4">
                            <label class="form-label text-white fw-bold small mb-2">E-mail ou usuário</label>
                            <div class="input-group">
                                <span class="input-group-text input-group-text-dark rounded-start-3"><i class="bi bi-person"></i></span>
                                <input type="text" name="usuario" class="form-control input-dark py-2 rounded-end-3" placeholder="Digite seu e-mail ou usuário" required>
                            </div>
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label text-white fw-bold small mb-2">Senha</label>
                            <div class="input-group">
                                <span class="input-group-text input-group-text-dark rounded-start-3">
                                    <i class="bi bi-lock"></i>
                                </span>

                                <input type="password"
                                       id="senha"
                                       name="senha"
                                       class="form-control input-dark py-2"
                                       placeholder="Digite sua senha"
                                       required>

                                <button type="button"
                                        id="alternarSenha"
                                        class="input-group-text input-group-text-dark rounded-end-3"
                                        style="border-left: none; border-right: 1px solid rgba(255,255,255,0.1); cursor: pointer;"
                                        aria-label="Mostrar senha">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rememberMe" style="background-color: var(--navy-light); border-color: rgba(255,255,255,0.2);">
                                <label class="form-check-label text-white-50 small mt-1" for="rememberMe">
                                    Lembrar meu acesso
                                </label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary-custom w-100 py-3 d-flex justify-content-between align-items-center fw-bold rounded-3 shadow">
                            <span class="mx-auto ps-3">Entrar</span>
                            <i class="bi bi-arrow-right"></i>
                        </button>
                        
                        <div class="text-center mt-3">
                            <a href="#" class="text-cyan text-decoration-none small fw-bold">Esqueci minha senha</a>
                        </div>
                    </form>

                    <!-- MAPA DA CLÍNICA -->
                    <div class="mt-4 border-top border-secondary pt-3">
                        <label class="form-label text-white fw-bold small mb-2"><i class="bi bi-geo-alt-fill text-cyan"></i> Onde estamos</label>
                        <div id="mapa-clinica"></div>
                    </div>

                </div>

                <div class="text-white-50 small mb-2">
                    <div class="d-flex align-items-center mb-3 border-bottom border-secondary pb-3 login-footer-security">
                        <i class="bi bi-shield-check text-cyan fs-2 me-3"></i>
                        <span style="font-size: 0.88rem;">Seus dados protegidos<br>com segurança e conformidade</span>
                    </div>
                    <div style="font-size: 0.78rem;" class="opacity-75">
                        <p class="mb-1">© 2026 NeuroSync • Todos os direitos reservados</p>
                        <p class="mb-0">Versão 1.0.0</p>
                    </div>
                </div>
            </div>

            <!-- ========================================== -->
            <!-- COLUNA DIREITA (Ilustração e Apresentação)  -->
            <!-- ========================================== -->
            <div class="col-lg-7 col-xl-8 d-none d-lg-flex flex-column login-content justify-content-between"
                 style="background-color: #f4f6fa;">
                
                <div class="p-4 p-xl-5 flex-shrink-0">
                    <h1 class="fw-bolder mb-3" style="font-size: clamp(2rem, 2.6vw, 2.8rem); color: var(--navy);">
                        Gestão inteligente. <span class="text-cyan">Cuidado integrado.</span>
                    </h1>
                    <p class="text-muted mb-0" style="font-size: clamp(1rem, 1.1vw, 1.15rem); max-width: 900px; font-weight: 500;">
                        Um sistema completo de Gestão Clínica e Prontuário Eletrônico do Paciente (PEP), 
                        projetado com foco em neuropsicopedagogia e neurodesenvolvimento.
                    </p>
                </div>

                <div class="flex-grow-1 d-flex justify-content-center align-items-end w-100 pb-3 login-image-area overflow-hidden">
                    <img src="/images/Background-tela-login.png" 
                         style="max-height: 90%; width: auto; max-width: 95%; object-fit: contain; object-position: center bottom;" 
                         alt="Ilustração NeuroSync" />
                </div>
                
            </div>

        </div>
    </div>

    <!-- ========================================== -->
    <!-- SCRIPTS DA PÁGINA                            -->
    <!-- ========================================== -->
    <script>
        // Lógica de alternar a visualização da senha
        const botao = document.getElementById("alternarSenha");
        const senha = document.getElementById("senha");

        botao.addEventListener("click", function () {
            const visivel = senha.type === "text";

            senha.type = visivel ? "password" : "text";
            this.querySelector("i").className =
                visivel ? "bi bi-eye" : "bi bi-eye-slash";

            this.setAttribute(
                "aria-label",
                visivel ? "Mostrar senha" : "Ocultar senha"
            );
        });
    </script>
    
    <!-- SCRIPTS DO OPENFREEMAP (MapLibre) -->
    <script src="https://unpkg.com/maplibre-gl@3.x/dist/maplibre-gl.js"></script>
    <script>
        // Ordem do MapLibre: [Longitude, Latitude]
        // Mantido o centro em Curitiba para testes
        const coordenadasClinica = [-49.2733, -25.4284]; 

        const map = new maplibregl.Map({
            container: 'mapa-clinica',
            style: 'https://tiles.openfreemap.org/styles/liberty', // Estilo do mapa
            center: coordenadasClinica,
            zoom: 14,
            attributionControl: false // Remove os textos de direitos autorais para visual mais limpo
        });

        // Adiciona o pino no mapa usando a cor da sua paleta (--cyan)
        new maplibregl.Marker({ color: "#16C4C8" })
            .setLngLat(coordenadasClinica)
            .addTo(map);
    </script>
</body>
</html>